{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "framework": "nextjs"
    },
    "backend": {
      "root": ".",
      "entrypoint": "server.app:app",
      "functions": {
        "server.app": {
          "excludeFiles": "{vendor,docs,tests,scripts,testbench,web,.venv,.pytest_cache,.superpowers,.vscode,.claude}/**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
